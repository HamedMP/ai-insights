{
  "name": "ai-insights-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Menu bar and system tray app for AI Insights. Not part of the ai-insights npm package.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/clean-ui.mjs && tsc -p ui/tsconfig.json",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tauri dev",
    "dev:fixture": "AI_INSIGHTS_CLI=\"$PWD/fixtures/fake-cli.mjs\" tauri dev",
    "build": "tauri build",
    "check": "pnpm typecheck && pnpm test && pnpm build:ui"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.33.4"
}
