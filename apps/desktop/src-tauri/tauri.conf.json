{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Insights",
  "version": "0.1.0",
  "identifier": "app.ai-insights.desktop",
  "build": {
    "frontendDist": "../ui/static",
    "beforeDevCommand": "pnpm build:ui",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "AI Insights",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Your AI coding-agent week at a glance",
    "longDescription": "Shows today, this week and this month from your local AI coding-agent history, with one tip. Runs the AI Insights CLI on this computer; nothing leaves it.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  },
  "plugins": {}
}
