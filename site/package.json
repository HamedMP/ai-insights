{
  "name": "ai-insights-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-embed.mjs && next dev",
    "build": "node scripts/build-embed.mjs && next build && node scripts/check-build.mjs",
    "media": "node scripts/render-media.mjs",
    "typecheck": "tsc --noEmit",
    "check:redirect": "node scripts/check-build.mjs --redirect",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "7.9.25",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@vercel/functions": "3.11.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "geist": "^1.9.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "posthog-js": "1.444.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
